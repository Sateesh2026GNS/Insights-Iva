# Insights Iva frontend environment configuration.
# Copy this file to `.env` and adjust as needed.

# Base URL of the backend API.
# Development:
VITE_API_BASE_URL=http://localhost:8000
# Production (same-origin nginx proxy — leave empty when frontend nginx proxies /auth, /api, etc.):
# VITE_API_BASE_URL=
# Production (separate API host):
# VITE_API_BASE_URL=https://api.yourdomain.com

# e-Quotation QR base URL (required when ERP is opened via localhost but QR is scanned on a phone).
# Use your PC's LAN IP — find with ipconfig (Windows) or ip addr — not a hardcoded value in code.
# VITE_PUBLIC_APP_URL=http://192.168.1.100:5173
# Production:
# VITE_PUBLIC_APP_URL=https://app.yourdomain.com
# Also set the same value as FRONTEND_PUBLIC_BASE_URL in backend/.env for server-generated PDF QR codes.
# For phone testing, open the ERP at http://<LAN-IP>:5173 or set VITE_PUBLIC_APP_URL above.
# Vite is already configured with server.host=true for LAN access; allow port 5173 in Windows Firewall if needed.

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps (HR Site Visit — browser key restricted to Maps JavaScript API)
# VITE_GOOGLE_MAPS_API_KEY=
