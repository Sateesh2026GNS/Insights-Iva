# Insights Iva backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit the real .env.

# --- Database (PostgreSQL — required at runtime) ---
# Local dev with docker-compose.postgres.yml:
DATABASE_URL=postgresql+psycopg://insights_user:insights_dev@localhost:5432/insights_iva

# SQLite source for one-time data migration only (not runtime):
# SOURCE_DATABASE_URL=sqlite:///./smrt.db

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_MINUTES=120

# --- Login lockout ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30

# --- Email verification & password reset ---
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=15
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=3600
FRONTEND_BASE_URL=http://localhost:5173

# --- SMTP (required for Forgot Password — success only after real delivery) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@gnssoftwares.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=info@gnssoftwares.com

# --- Google Calendar + Google Meet (Meetings module) ---
# 1. Enable Google Calendar API in Google Cloud Console
# 2. Create OAuth 2.0 Web client → add redirect URI below
# 3. Restart backend after filling these values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/calendar/callback
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Environment: development | production ---
# In production, email verification is required before login.
# Production requires: strong JWT_SECRET_KEY, PostgreSQL DATABASE_URL,
# CORS_ORIGINS (no localhost), ALLOWED_HOSTS (your domain).
ENVIRONMENT=development

# Comma-separated trusted frontend origins (required in production — no localhost or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated hostnames for TrustedHostMiddleware (production domain(s))
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production example (do not commit real values) ---
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db-host:5432/insights_iva
# JWT_SECRET_KEY=<openssl rand -hex 32>
# FRONTEND_BASE_URL=https://app.yourdomain.com
# CORS_ORIGINS=https://app.yourdomain.com
# ALLOWED_HOSTS=app.yourdomain.com,api.yourdomain.com
# GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/integrations/google/calendar/callback

# --- SaaS: public registration disabled; companies created by Super Admin ---
ALLOW_PUBLIC_REGISTRATION=false

# --- GNS Super Admin (single platform administrator) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
SUPER_ADMIN_MOBILE=+910000000000

# --- SMS OTP (optional — OTP logged to console when empty) ---
SMS_API_KEY=

# --- AI Operator Assistant (OpenAI-compatible LLM) ---
# Leave LLM_API_KEY empty to use rule-based intent + real ERP data (no external API).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_TIMEOUT_SECONDS=30
AI_ASSISTANT_ENABLED=true
